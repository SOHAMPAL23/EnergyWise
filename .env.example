# ──────────────────────────────────────────────────────────────────────────────
# EnergyWise API — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# ── Service ───────────────────────────────────────────────────────────────────
APP_NAME="EnergyWise Demand Forecasting API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"     # development | staging | production
DEBUG="false"

# ── Server ────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT="8000"
WORKERS="1"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'

# ── Authentication ────────────────────────────────────────────────────────────
# Replace with a strong random secret in staging/production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY="dev-insecure-key-change-in-production"
API_KEY_NAME="X-API-Key"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Only required when persistence features are enabled.
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg2://energywise:energywise@localhost:5432/energywise"
DB_ECHO_SQL="false"

# ── ML Artifacts ──────────────────────────────────────────────────────────────
# Defaults resolve relative to the project root; override for custom locations.
# ARTIFACTS_DIR="/absolute/path/to/ml/artifacts"
# MANIFEST_PATH="/absolute/path/to/ml/artifacts/manifest.json"
MODEL_VERSION_DAILY="v2"
MODEL_VERSION_WEEKLY="v2"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"    # DEBUG | INFO | WARNING | ERROR | CRITICAL
